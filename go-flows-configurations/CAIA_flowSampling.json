{
  "version": "v2",
  "preprocessing": {
    "flows": [
      {
        "features": [
            "flowStartMilliseconds",

            "sourceIPAddress",
            "destinationIPAddress",
            "sourceTransportPort",
            "destinationTransportPort",
            "protocolIdentifier",

            {"apply": [{"accumulate":["octetTotalCount"]}, "forward"]},
            {"apply": [{"accumulate":["tcpSynTotalCount"]}, "forward"]},
            {"apply": [{"accumulate":["tcpAckTotalCount"]}, "forward"]},
            {"apply": [{"accumulate":["tcpFinTotalCount"]}, "forward"]},
            {"apply": [{"accumulate":["_tcpCwrTotalCount"]}, "forward"]},

            {"apply": [{"accumulate":["octetTotalCount"]}, "backward"]},
            {"apply": [{"accumulate":["tcpSynTotalCount"]}, "backward"]},
            {"apply": [{"accumulate":["tcpAckTotalCount"]}, "backward"]},
            {"apply": [{"accumulate":["tcpFinTotalCount"]}, "backward"]},
            {"apply": [{"accumulate":["_tcpCwrTotalCount"]}, "backward"]},

            {"apply": [{"accumulate":["ipTotalLength"]}, "forward"]},
            {"apply": [{"accumulate":["_interPacketTimeSeconds"]}, "forward"]},
            {"apply": [{"accumulate":["ipTotalLength"]}, "backward"]},
            {"apply": [{"accumulate":["_interPacketTimeSeconds"]}, "backward"]}

        ],
    "active_timeout": 1800,
    "idle_timeout": 300,
    "bidirectional": true,
    "key_features": [
        "sourceIPAddress",
        "destinationIPAddress",
        "protocolIdentifier",
        "sourceTransportPort",
        "destinationTransportPort"
        ]
      }
    ]
  }
}